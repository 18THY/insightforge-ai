# Copy this file to `.env` and adjust values for your local environment.
# `.env` is git-ignored and must never be committed.

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
POSTGRES_USER=insightforge
POSTGRES_PASSWORD=insightforge
POSTGRES_DB=insightforge
POSTGRES_PORT=5432

# Full connection string used by the backend service.
# Host is "db" inside Docker Compose, "localhost" when running the backend
# directly on your machine.
DATABASE_URL=postgresql://insightforge:insightforge@localhost:5432/insightforge

# ---------------------------------------------------------------------------
# Backend (FastAPI)
# ---------------------------------------------------------------------------
BACKEND_PORT=8000
ENVIRONMENT=development

# Comma-separated list of origins allowed to call the backend API.
CORS_ALLOW_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Frontend (Next.js)
# ---------------------------------------------------------------------------
FRONTEND_PORT=3000

# Base URL the frontend uses to reach the backend API. Must be prefixed
# with NEXT_PUBLIC_ to be readable in the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# AI (reserved for a later phase — not yet used)
# ---------------------------------------------------------------------------
# GEMINI_API_KEY=
